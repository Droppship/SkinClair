[
  {
    "name": "theme_info",
    "theme_name": "SkinClair",
    "theme_version": "1.0.0",
    "theme_author": "SkinClair Studio",
    "theme_documentation_url": "https://github.com/droppship/skinclair",
    "theme_support_url": "https://github.com/droppship/skinclair"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background (deep plum)",
        "default": "#1c1216"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surfaces (cards, panels)",
        "default": "#2a1c24"
      },
      {
        "type": "color",
        "id": "color_soft",
        "label": "Soft background (alternating sections)",
        "default": "#241820"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Main text (ivory)",
        "default": "#f4ece5"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text (muted rose gold)",
        "default": "#a9807a"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (rose gold)",
        "default": "#d9b3ab"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Buttons (rose gold)",
        "default": "#d9b3ab"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#1c1216"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold (stars, details)",
        "default": "#d9b3ab"
      },
      {
        "type": "color",
        "id": "color_berry",
        "label": "Berry accent (badges, highlights)",
        "default": "#7c2e3f"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders and dividers",
        "default": "#3a2830"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Maximum content width",
        "min": 1000,
        "max": 1440,
        "step": 20,
        "unit": "px",
        "default": 1240
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "48 × 48 px recommended"
      }
    ]
  },
  {
    "name": "Cart & shipping",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "$",
        "default": 50
      }
    ]
  },
  {
    "name": "Product pages",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_low_stock",
        "label": "Show low stock alert",
        "info": "Subtle urgency: only shown when inventory tracking is on and stock is under the threshold.",
        "default": true
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Low stock threshold",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "show_quick_add",
        "label": "Quick add to cart on product cards",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "Pinterest"
      }
    ]
  }
]

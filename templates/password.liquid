{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} — {{ 'general.password.title' | t }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,400&family=Manrope:wght@300;400;500&display=swap" rel="stylesheet">
    {{ content_for_header }}
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Manrope', sans-serif; font-weight: 300;
        background: {{ settings.color_background | default: '#1c1216' }};
        color: {{ settings.color_text | default: '#f4ece5' }};
        display: flex; align-items: center; justify-content: center;
        min-height: 100vh; padding: 24px; text-align: center;
      }
      .wrap { max-width: 520px; }
      .brand { font-family: 'Playfair Display', serif; font-size: 42px; font-weight: 600; letter-spacing: 2px; margin-bottom: 10px; }
      h1 { font-family: 'Playfair Display', serif; font-weight: 500; font-size: 26px; font-style: italic; margin-bottom: 12px; }
      p { color: #a9807a; margin-bottom: 26px; }
      form { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
      input {
        flex: 1; min-width: 220px; padding: 14px 22px; font: inherit;
        border: 1px solid {{ settings.color_line | default: '#3a2830' }};
        border-radius: 999px; background: #2a1c24;
      }
      button {
        padding: 14px 30px; font: inherit; cursor: pointer;
        border: none; border-radius: 999px;
        background: {{ settings.color_button | default: '#d9b3ab' }};
        color: {{ settings.color_button_text | default: '#1c1216' }};
        text-transform: uppercase; letter-spacing: 2px; font-size: 13px;
      }
      .password-toggle { margin-top: 40px; font-size: 13px; }
      .password-toggle a { color: inherit; }
      .error { color: #e0a1ad; font-size: 14px; margin: 10px 0 0; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p class="brand">{{ shop.name }}</p>
      <h1>{{ 'general.password.title' | t }}</h1>
      <p>{{ 'general.password.notify' | t }}</p>

      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
        {%- if form.posted_successfully? -%}
          <p style="color: #9fcaa9;">{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
          <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
        {%- endif -%}
      {%- endform -%}

      <div class="password-toggle">
        {%- form 'storefront_password' -%}
          <input type="password" name="password" placeholder="{{ 'general.password.password_label' | t }}" style="min-width: 180px;">
          <button type="submit">{{ 'general.password.enter' | t }}</button>
          {%- if form.errors -%}
            <p class="error">{{ form.errors.messages['form'] }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </body>
</html>

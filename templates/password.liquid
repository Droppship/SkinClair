{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} — {{ 'general.password.title' | t }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    {{ content_for_header }}
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', sans-serif;
        background: {{ settings.color_background | default: '#FFFFFF' }};
        color: {{ settings.color_text | default: '#111111' }};
        display: flex; align-items: center; justify-content: center;
        min-height: 100vh; padding: 24px; text-align: center;
      }
      .wrap { max-width: 520px; }
      .brand { font-family: 'Marcellus', serif; font-size: 34px; letter-spacing: 4px; text-transform: uppercase; margin-bottom: 14px; }
      h1 { font-family: 'Marcellus', serif; font-weight: 400; font-size: 24px; margin-bottom: 12px; }
      p { color: {{ settings.color_muted | default: '#6E6E6E' }}; margin-bottom: 28px; }
      form { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
      input {
        flex: 1; min-width: 220px; padding: 14px 18px; font: inherit;
        border: 1px solid {{ settings.color_line | default: '#E9E9E7' }};
        border-radius: 2px; background: #fff;
      }
      input:focus { outline: none; border-color: {{ settings.color_text | default: '#111111' }}; }
      button {
        padding: 14px 30px; font: inherit; cursor: pointer;
        border: 1px solid {{ settings.color_text | default: '#111111' }}; border-radius: 2px;
        background: {{ settings.color_text | default: '#111111' }};
        color: {{ settings.color_background | default: '#FFFFFF' }};
        text-transform: uppercase; letter-spacing: 2px; font-size: 12px;
        transition: background 0.25s ease, color 0.25s ease;
      }
      button:hover { background: transparent; color: {{ settings.color_text | default: '#111111' }}; }
      .password-toggle { margin-top: 44px; font-size: 13px; }
      .password-toggle a { color: inherit; }
      .error { color: #8A2A22; font-size: 14px; margin: 10px 0 0; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p class="brand">{{ shop.name }}</p>
      <h1>{{ 'general.password.title' | t }}</h1>
      <p>{{ 'general.password.notify' | t }}</p>

      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
        {%- if form.posted_successfully? -%}
          <p>{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
          <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
        {%- endif -%}
      {%- endform -%}

      <div class="password-toggle">
        {%- form 'storefront_password' -%}
          <input type="password" name="password" placeholder="{{ 'general.password.password_label' | t }}" style="min-width: 180px;">
          <button type="submit">{{ 'general.password.enter' | t }}</button>
          {%- if form.errors -%}
            <p class="error">{{ form.errors.messages['form'] }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </body>
</html>

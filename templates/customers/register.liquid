<section class="section">
  <div class="page-width">
    <div class="customer-page">
      <div class="page-title">
        <h1>{{ 'customer.register.title' | t }}</h1>
      </div>

      <div class="customer-card">
        {%- form 'create_customer' -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="grid grid--2" style="gap: 0 16px;">
            <div class="field">
              <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
              <input type="text" id="RegisterFirstName" name="customer[first_name]" class="field__input" autocomplete="given-name">
            </div>
            <div class="field">
              <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
              <input type="text" id="RegisterLastName" name="customer[last_name]" class="field__input" autocomplete="family-name">
            </div>
          </div>
          <div class="field">
            <label for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
            <input type="email" id="RegisterEmail" name="customer[email]" class="field__input" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
            <input type="password" id="RegisterPassword" name="customer[password]" class="field__input" autocomplete="new-password" required>
          </div>
          <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
        {%- endform -%}
      </div>

      <p class="customer-links">
        {{ 'customer.register.already' | t }}
        <a href="{{ routes.account_login_url }}">{{ 'customer.register.login' | t }}</a>
      </p>
    </div>
  </div>
</section>

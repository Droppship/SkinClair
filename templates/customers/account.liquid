<section class="section">
  <div class="page-width">
    <div class="customer-page customer-page--wide">
      <div class="page-title">
        <h1>{{ 'customer.account.title' | t }}</h1>
        {%- assign customer_name = customer.first_name | default: customer.email -%}
        <p>{{ 'customer.account.welcome' | t: name: customer_name }}</p>
      </div>

      <div class="customer-card">
        <h2 class="h3" style="margin-bottom: 18px;">{{ 'customer.account.orders' | t }}</h2>

        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div style="overflow-x: auto;">
              <table class="orders-table">
                <thead>
                  <tr>
                    <th>{{ 'customer.account.order_number' | t }}</th>
                    <th>{{ 'customer.account.date' | t }}</th>
                    <th>{{ 'customer.account.status' | t }}</th>
                    <th>{{ 'customer.account.total' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td><a href="{{ order.customer_url }}" style="text-decoration: underline; text-underline-offset: 3px;">{{ order.name }}</a></td>
                      <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                      <td>{{ order.financial_status_label }} — {{ order.fulfillment_status_label }}</td>
                      <td>{{ order.total_price | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <p class="text-muted">{{ 'customer.account.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      <p class="customer-links">
        <a href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t }} ({{ customer.addresses_count }})</a>
        &nbsp;·&nbsp;
        <a href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
      </p>
    </div>
  </div>
</section>

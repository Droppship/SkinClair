{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_card.subtext' | t }} — {{ shop.name }}</title>
    <meta name="robots" content="noindex">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', sans-serif;
        background: {{ settings.color_soft | default: '#F7F7F6' }};
        color: {{ settings.color_text | default: '#111111' }};
        display: flex; align-items: center; justify-content: center;
        min-height: 100vh; padding: 24px;
      }
      .card {
        background: #fff; border: 1px solid {{ settings.color_line | default: '#E9E9E7' }}; border-radius: 2px;
        padding: 48px 40px;
        max-width: 460px; width: 100%; text-align: center;
      }
      h1 { font-family: 'Marcellus', serif; font-weight: 400; font-size: 26px; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 8px; }
      .balance { font-family: 'Marcellus', serif; font-size: 48px; margin: 20px 0 6px; }
      .code {
        display: inline-block; margin: 18px 0 26px; padding: 14px 28px;
        border: 1px dashed {{ settings.color_line | default: '#E9E9E7' }};
        border-radius: 2px; font-size: 20px; letter-spacing: 3px;
      }
      .btn {
        display: inline-block; padding: 15px 34px; border: 1px solid {{ settings.color_text | default: '#111111' }}; border-radius: 2px;
        background: {{ settings.color_text | default: '#111111' }};
        color: #fff;
        text-decoration: none; text-transform: uppercase; letter-spacing: 2px; font-size: 12px;
        transition: background 0.25s ease, color 0.25s ease;
      }
      .btn:hover { background: transparent; color: {{ settings.color_text | default: '#111111' }}; }
      .muted { color: {{ settings.color_muted | default: '#6E6E6E' }}; font-size: 14px; margin-top: 18px; }
      img { max-width: 100%; margin: 0 auto 16px; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>{{ shop.name }}</h1>
      <p>{{ 'gift_card.subtext' | t }}</p>
      <p class="balance">{{ gift_card.balance | money }}</p>
      {%- if gift_card.expired or gift_card.enabled != true -%}
        <p class="muted">This gift card is no longer valid.</p>
      {%- endif -%}
      <p class="code">{{ gift_card.code | format_code }}</p>
      <div>
        <a class="btn" href="{{ shop.url }}">{{ 'gift_card.shop_now' | t }}</a>
      </div>
      <p class="muted">
        <a href="#" onclick="window.print(); return false;" style="color: inherit;">{{ 'gift_card.print' | t }}</a>
      </p>
    </div>
  </body>
</html>

<section class="section{% if section.settings.background == 'soft' %} section--soft{% elsif section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <ol class="steps" role="list" style="--steps-cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="step reveal" {{ block.shopify_attributes }}>
          <span class="step__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="step__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank -%}
      <div class="steps__cta reveal">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How to use",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Simple ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to use it"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Four effortless steps to a fresh, even, rested-looking complexion."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button (optional)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Ivory" },
        { "value": "soft", "label": "Soft pink" },
        { "value": "surface", "label": "White" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose your shade"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pick the shade closest to your skin tone."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to use",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose your shade", "text": "Pick the shade closest to your skin tone from our four flexible tones." } },
        { "type": "step", "settings": { "title": "Apply under the eyes", "text": "Press a small amount under the eyes with the applicator or a brush." } },
        { "type": "step", "settings": { "title": "Blend gently", "text": "Blend outward with soft taps until the powder melts into your skin." } },
        { "type": "step", "settings": { "title": "Enjoy an even complexion", "text": "A smooth, natural finish that stays comfortable all day." } }
      ]
    }
  ]
}
{% endschema %}

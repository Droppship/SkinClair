{%- liquid
  assign target_url = routes.all_products_collection_url
  if section.settings.product != blank
    assign target_url = section.settings.product.url
  endif
-%}

<section class="section{% if section.settings.background == 'soft' %} section--soft{% elsif section.settings.background == 'surface' %} section--surface{% endif %}" id="shades">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="shade-grid" style="--shade-cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <a href="{{ target_url }}" class="shade-card reveal" {{ block.shopify_attributes }}>
          <span class="shade-card__dot" style="--shade: {{ block.settings.color }};" aria-hidden="true"></span>
          <span class="shade-card__name">{{ block.settings.title }}</span>
          {%- if block.settings.text != blank -%}
            <span class="shade-card__desc">{{ block.settings.text }}</span>
          {%- endif -%}
          <span class="shade-card__cta">{{ section.settings.cta_label }} {% render 'icon', name: 'chevron-right', size: 13 %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shade selector",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find your match"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four shades, one perfect match"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Flexible, buildable tones designed to melt into your skin — from light to deep."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Linked product",
      "info": "Each shade card links to this product page."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Card link text",
      "default": "Shop this shade"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Ivory" },
        { "value": "soft", "label": "Soft pink" },
        { "value": "surface", "label": "White" }
      ],
      "default": "soft"
    }
  ],
  "blocks": [
    {
      "type": "shade",
      "name": "Shade",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Shade name",
          "default": "Light Bisque"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Swatch color",
          "default": "#F2D8BE"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "For light skin with neutral undertones"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shade selector",
      "blocks": [
        { "type": "shade", "settings": { "title": "Light Bisque", "color": "#F2D8BE", "text": "For light skin with neutral undertones" } },
        { "type": "shade", "settings": { "title": "Warm Bisque", "color": "#E4BC94", "text": "For light-to-medium skin with warm undertones" } },
        { "type": "shade", "settings": { "title": "Extra Deep Peach", "color": "#A2603C", "text": "For deep skin with peachy undertones" } },
        { "type": "shade", "settings": { "title": "Very Deep Beige", "color": "#7C4A2F", "text": "For very deep skin with neutral undertones" } }
      ]
    }
  ]
}
{% endschema %}

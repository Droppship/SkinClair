{%- if section.settings.enable -%}
  <div
    class="popup"
    id="NewsletterPopup"
    role="dialog"
    aria-modal="true"
    aria-labelledby="NewsletterPopupTitle"
    data-delay="{{ section.settings.delay }}"
    data-frequency="{{ section.settings.frequency }}"
  >
    <div class="popup__backdrop" data-popup-close></div>
    <div class="popup__card">
      <button class="popup__close" data-popup-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close', size: 18 %}
      </button>
      <div class="popup__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="" width="400" height="500" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="popup__content">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 id="NewsletterPopupTitle">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        {%- form 'customer', id: 'PopupNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" data-newsletter-success hidden>{{ 'general.newsletter.success' | t }}</p>
          {%- else -%}
            <div class="newsletter__form">
              <input
                type="email"
                name="contact[email]"
                placeholder="{{ 'general.newsletter.placeholder' | t }}"
                aria-label="{{ 'general.newsletter.label' | t }}"
                autocomplete="email"
                required
              >
              <button type="submit" class="btn">{{ section.settings.button_label }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
        <button class="popup__dismiss" data-popup-close>{{ section.settings.dismiss_label }}</button>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Pop-up e-mail",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Activer le pop-up",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Délai d'apparition",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "range",
      "id": "frequency",
      "label": "Ne pas réafficher pendant",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "j",
      "default": 7
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Offre de bienvenue"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "-10 % sur votre première commande"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "Inscrivez-vous et recevez votre code exclusif, nos rituels beauté et nos ventes privées."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Je profite de -10 %"
    },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "Lien de refus",
      "default": "Non merci, je préfère payer plein tarif"
    }
  ]
}
{% endschema %}

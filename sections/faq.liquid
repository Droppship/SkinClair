<section class="section{% if section.settings.background == 'soft' %} section--soft{% elsif section.settings.background == 'surface' %} section--surface{% endif %}" id="faq">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="faq reveal">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            {{ block.settings.question }}
            {% render 'icon', name: 'plus', size: 18 %}
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Besoin d'aide ?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Questions fréquentes"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sous-texte"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Ouvrir la première question",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Ivoire" },
        { "value": "soft", "label": "Rose doux" },
        { "value": "surface", "label": "Blanc" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Quels sont les délais de livraison ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Votre commande est préparée sous 24 h et livrée en 2 à 4 jours ouvrés en France métropolitaine. La livraison est offerte dès 50 € d'achat.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Vos produits conviennent-ils aux peaux sensibles ?", "answer": "<p>Oui. Nos formules sont testées dermatologiquement, sans parfum agressif ni ingrédient controversé. En cas de doute, effectuez un test sur une petite zone et consultez la liste INCI complète sur chaque fiche produit.</p>" } },
        { "type": "question", "settings": { "question": "Puis-je retourner un produit ?", "answer": "<p>Absolument. Vous disposez de 30 jours après réception pour changer d'avis. Le produit doit être non ouvert ; le remboursement est effectué sous 5 jours après réception du retour.</p>" } },
        { "type": "question", "settings": { "question": "Les paiements sont-ils sécurisés ?", "answer": "<p>Oui, toutes les transactions sont chiffrées (SSL) et traitées par des prestataires certifiés PCI-DSS : carte bancaire, PayPal, Apple Pay et Google Pay.</p>" } }
      ]
    }
  ]
}
{% endschema %}

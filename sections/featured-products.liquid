{%- liquid
  assign products_source = section.settings.collection.products
  if section.settings.collection == blank
    assign products_source = collections.all.products
  endif
-%}
<section class="section{% if section.settings.background == 'soft' %} section--soft{% endif %}">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="product-row">
      {%- for product in products_source limit: section.settings.limit -%}
        {% render 'product-card', card_product: product %}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="product-card reveal">
            <div class="product-card__media">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">Product {{ i }}</h3>
              <p class="product-card__subtitle">Add your products in the admin</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div style="text-align: center; margin-top: 56px;" class="reveal">
        <a href="{{ section.settings.collection.url }}" class="link-underline">{{ 'products.view_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our products"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Without a collection, all products are shown."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": false
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "soft", "label": "Light gray" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}

<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <p class="site-footer__logo">{{ shop.name }}</p>
        {%- if section.settings.brand_text != blank -%}
          <p>{{ section.settings.brand_text }}</p>
        {%- endif -%}
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_instagram' | t }}">{% render 'icon', name: 'instagram', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_tiktok' | t }}">{% render 'icon', name: 'tiktok', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_facebook' | t }}">{% render 'icon', name: 'facebook', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_pinterest' | t }}">{% render 'icon', name: 'pinterest', size: 18 %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              <ul class="site-footer__links list-unstyled" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>

      <ul class="site-footer__policies" role="list">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_payment_icons -%}
        <div class="site-footer__payments" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Beauty essentials, made simple. Thoughtfully designed products for a natural look."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment methods",
      "default": true
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer",
          "info": "Recommended links: Contact, FAQ, Privacy policy, Terms of service, Refund policy, Shipping policy."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Shop" } },
      { "type": "link_list", "settings": { "heading": "Help" } }
    ]
  }
}
{% endschema %}

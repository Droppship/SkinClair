<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <p class="site-footer__logo">{{ shop.name }}</p>
        {%- if section.settings.brand_text != blank -%}
          <p>{{ section.settings.brand_text }}</p>
        {%- endif -%}
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_instagram' | t }}">{% render 'icon', name: 'instagram', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_tiktok' | t }}">{% render 'icon', name: 'tiktok', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_facebook' | t }}">{% render 'icon', name: 'facebook', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_pinterest' | t }}">{% render 'icon', name: 'pinterest', size: 18 %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              <ul class="site-footer__links list-unstyled" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}

      <div class="site-footer__newsletter">
        <h4>{{ section.settings.newsletter_heading }}</h4>
        <p>{{ section.settings.newsletter_text }}</p>
        {%- form 'customer', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" data-newsletter-success>{{ 'general.newsletter.success' | t }}</p>
          {%- else -%}
            <input
              type="email"
              name="contact[email]"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              aria-label="{{ 'general.newsletter.label' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="btn btn--card">{{ 'general.newsletter.submit' | t }}</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</p>

      <ul class="site-footer__policies" role="list">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_payment_icons -%}
        <div class="site-footer__payments" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Texte de marque",
      "default": "Des soins essentiels, formulés avec exigence, pour révéler l'éclat naturel de votre peau."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Titre newsletter",
      "default": "Rejoignez le cercle"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Texte newsletter",
      "default": "Recevez -10 % sur votre première commande, nos conseils beauté et nos offres privées."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Afficher les moyens de paiement",
      "default": true
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Boutique"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Boutique" } },
      { "type": "link_list", "settings": { "heading": "Informations" } }
    ]
  }
}
{% endschema %}

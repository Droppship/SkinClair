{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<section class="section" data-product-root>
  <div class="page-width">
    <div class="product__grid">

      {%- comment -%} ————— Gallery ————— {%- endcomment -%}
      <div class="product__gallery">
        <div class="product__main-media" data-zoom-container>
          {%- if product.featured_media -%}
            <img
              data-main-image
              src="{{ product.featured_media | image_url: width: 1100 }}"
              srcset="{{ product.featured_media | image_url: width: 750 }} 750w, {{ product.featured_media | image_url: width: 1100 }} 1100w, {{ product.featured_media | image_url: width: 1600 }} 1600w"
              sizes="(min-width: 990px) 55vw, 100vw"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="1100"
              height="{{ 1100 | divided_by: product.featured_media.aspect_ratio | round }}"
              fetchpriority="high"
            >
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs" role="list">
            {%- for media in product.media -%}
              <button
                type="button"
                data-thumb
                data-full-src="{{ media | image_url: width: 1100 }}"
                data-full-srcset="{{ media | image_url: width: 750 }} 750w, {{ media | image_url: width: 1100 }} 1100w, {{ media | image_url: width: 1600 }} 1600w"
                class="{% if forloop.first %}is-active{% endif %}"
                aria-label="View image {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 144 }}" alt="{{ media.alt | escape }}" width="72" height="72" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ————— Info ————— {%- endcomment -%}
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'vendor' -%}
              <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor | default: shop.name }}</p>

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'rating' -%}
              {%- if block.settings.rating_count != blank -%}
                <div class="product__rating" {{ block.shopify_attributes }}>
                  <span class="stars" role="img" aria-label="4.8 out of 5 stars">
                    {%- for i in (1..5) -%}{% render 'icon', name: 'star', size: 15 %}{%- endfor -%}
                  </span>
                  <a href="#reviews">{{ block.settings.rating_count }}</a>
                </div>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price" data-product-price {{ block.shopify_attributes }}>
                {% render 'price', item: current_variant %}
              </div>

            {%- when 'short_description' -%}
              {%- assign short = product.metafields.custom.short_description | default: block.settings.text -%}
              {%- if short != blank -%}
                <p class="product__short-desc" {{ block.shopify_attributes }}>{{ short }}</p>
              {%- endif -%}

            {%- when 'benefits' -%}
              <ul class="product__benefits" role="list" {{ block.shopify_attributes }}>
                {%- if block.settings.benefit_1 != blank -%}
                  <li>{% render 'icon', name: block.settings.icon_1, size: 18 %} {{ block.settings.benefit_1 }}</li>
                {%- endif -%}
                {%- if block.settings.benefit_2 != blank -%}
                  <li>{% render 'icon', name: block.settings.icon_2, size: 18 %} {{ block.settings.benefit_2 }}</li>
                {%- endif -%}
                {%- if block.settings.benefit_3 != blank -%}
                  <li>{% render 'icon', name: block.settings.icon_3, size: 18 %} {{ block.settings.benefit_3 }}</li>
                {%- endif -%}
                {%- if block.settings.benefit_4 != blank -%}
                  <li>{% render 'icon', name: block.settings.icon_4, size: 18 %} {{ block.settings.benefit_4 }}</li>
                {%- endif -%}
              </ul>

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'product', product, data-ajax-add: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">

                  {%- unless product.has_only_default_variant -%}
                    {%- assign swatch_lines = block.settings.shade_colors | newline_to_br | split: '<br />' -%}
                    <div class="variant-picker">
                      {%- for option in product.options_with_values -%}
                        {%- liquid
                          assign option_down = option.name | downcase
                          assign is_swatch = false
                          if option_down contains 'teinte' or option_down contains 'shade' or option_down contains 'couleur' or option_down contains 'color'
                            assign is_swatch = true
                          endif
                        -%}
                        <fieldset data-option-index="{{ forloop.index0 }}">
                          <legend class="form__label">
                            {{ option.name }}
                            {%- if is_swatch %} — <span class="variant-picker__selected" data-selected-value>{{ option.selected_value }}</span>{% endif -%}
                          </legend>
                          {%- for value in option.values -%}
                            {%- liquid
                              assign swatch_color = ''
                              if is_swatch
                                assign value_down = value | downcase
                                for line in swatch_lines
                                  assign pair = line | strip | split: ':'
                                  assign pair_name = pair[0] | strip | downcase
                                  if pair_name == value_down and pair[1] != blank
                                    assign swatch_color = pair[1] | strip
                                  endif
                                endfor
                              endif
                            -%}
                            <span class="variant-option{% if swatch_color != '' %} variant-option--swatch{% endif %}">
                              <input
                                type="radio"
                                id="Option-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                                name="options[{{ option.name | escape }}]"
                                value="{{ value | escape }}"
                                data-option-input
                                {% if option.selected_value == value %}checked{% endif %}
                              >
                              <label
                                for="Option-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                                {% if swatch_color != '' %}style="background-color: {{ swatch_color }};" title="{{ value | escape }}"{% endif %}
                              >{{ value }}</label>
                            </span>
                          {%- endfor -%}
                        </fieldset>
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}

                  {%- comment -%} Subtle urgency: real low stock only {%- endcomment -%}
                  {%- if settings.show_low_stock
                    and current_variant.inventory_management == 'shopify'
                    and current_variant.inventory_quantity > 0
                    and current_variant.inventory_quantity <= settings.low_stock_threshold -%}
                    <p class="product__stock product__stock--low" data-stock-status>
                      <span class="stock-dot stock-dot--pulse"></span>
                      {{ 'products.low_stock' | t: count: current_variant.inventory_quantity }}
                    </p>
                  {%- elsif current_variant.available -%}
                    <p class="product__stock product__stock--in" data-stock-status>
                      <span class="stock-dot"></span>
                      {{ 'products.in_stock' | t }}
                    </p>
                  {%- endif -%}

                  <div class="product__buy" style="margin-top: 16px;">
                    <div class="qty">
                      <button type="button" data-qty-change="-1" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', name: 'minus', size: 15 %}</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.quantity' | t }}">
                      <button type="button" data-qty-change="1" aria-label="{{ 'products.increase' | t }}">{% render 'icon', name: 'plus', size: 15 %}</button>
                    </div>
                    <button
                      type="submit"
                      name="add"
                      class="btn"
                      data-atc-button
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      {%- if current_variant.available -%}
                        {{ 'products.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.sold_out' | t }}
                      {%- endif -%}
                    </button>
                  </div>

                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}

                <div class="product__trust">
                  <span>{% render 'icon', name: 'lock', size: 15 %} 100% secure payment</span>
                  <span>{% render 'icon', name: 'truck', size: 15 %} Ships in 48–72 h</span>
                  <span>{% render 'icon', name: 'return', size: 15 %} 30-day returns</span>
                </div>
              </div>

            {%- when 'guarantee' -%}
              <div class="product__guarantee" {{ block.shopify_attributes }}>
                {% render 'icon', name: 'shield', size: 24 %}
                <div>
                  <strong>{{ block.settings.title }}</strong>
                  <p>{{ block.settings.text }}</p>
                </div>
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__accordions" {{ block.shopify_attributes }}>
                  <details open>
                    <summary>{{ block.settings.title }} {% render 'icon', name: 'plus', size: 17 %}</summary>
                    <div class="rte">{{ product.description }}</div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'accordion' -%}
              {%- liquid
                assign content = block.settings.content
                if block.settings.metafield_key != blank
                  assign parts = block.settings.metafield_key | split: '.'
                  assign mf = product.metafields[parts[0]][parts[1]]
                  if mf != blank
                    assign content = mf
                  endif
                endif
              -%}
              {%- if content != blank -%}
                <div class="product__accordions" {{ block.shopify_attributes }}>
                  <details>
                    <summary>{{ block.settings.title }} {% render 'icon', name: 'plus', size: 17 %}</summary>
                    <div class="rte">{{ content }}</div>
                  </details>
                </div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product.variants | json }}</script>

  {%- comment -%} Fixed mobile buy bar {%- endcomment -%}
  <div class="sticky-atc" data-sticky-atc aria-hidden="true">
    <div class="sticky-atc__info">
      <p class="sticky-atc__title">{{ product.title }}</p>
      <p class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</p>
    </div>
    <button type="button" class="btn" data-sticky-submit>{{ 'products.add_to_cart' | t }}</button>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {% if product.featured_media %}"image": [{{ product.featured_media | image_url: width: 1100 | prepend: 'https:' | json }}],{% endif %}
      "description": {{ product.description | strip_html | json }},
      {% if product.selected_or_first_available_variant.sku != blank %}"sku": {{ product.selected_or_first_available_variant.sku | json }},{% endif %}
      "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "url": {{ request.origin | append: variant.url | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Product page",
  "blocks": [
    {
      "type": "vendor",
      "name": "Brand",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Rating (stars)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "rating_count",
          "label": "Review link text",
          "info": "E.g. \"127 reviews\". Leave blank to hide. Automatically replaced if you install a review app (Judge.me, Loox…).",
          "default": "★ 4.8 — read reviews"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "short_description",
      "name": "Short description",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Fallback text",
          "info": "Used when the custom.short_description metafield is empty.",
          "default": "A daily treatment that transforms your routine: visibly smoother, hydrated, and glowing skin within the first weeks."
        }
      ]
    },
    {
      "type": "benefits",
      "name": "Benefits (icons)",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "icon_1", "label": "Icon 1", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "rabbit", "label": "Rabbit" }, { "value": "lab", "label": "Lab" }, { "value": "heart", "label": "Heart" }], "default": "leaf" },
        { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "97% naturally derived ingredients" },
        { "type": "select", "id": "icon_2", "label": "Icon 2", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "rabbit", "label": "Rabbit" }, { "value": "lab", "label": "Lab" }, { "value": "heart", "label": "Heart" }], "default": "drop" },
        { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "24-hour hydration" },
        { "type": "select", "id": "icon_3", "label": "Icon 3", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "rabbit", "label": "Rabbit" }, { "value": "lab", "label": "Lab" }, { "value": "heart", "label": "Heart" }], "default": "rabbit" },
        { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "Cruelty-free & vegan" },
        { "type": "select", "id": "icon_4", "label": "Icon 4", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "rabbit", "label": "Rabbit" }, { "value": "lab", "label": "Lab" }, { "value": "heart", "label": "Heart" }], "default": "lab" },
        { "type": "text", "id": "benefit_4", "label": "Benefit 4", "default": "Dermatologist-tested" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Accelerated checkout (Apple Pay, PayPal…)",
          "default": true
        },
        {
          "type": "textarea",
          "id": "shade_colors",
          "label": "Shade swatch colors",
          "info": "One per line, format \"Variant name: #hex\". Applied to options named Teinte / Shade / Couleur / Color — matching values render as color dots instead of text pills.",
          "default": "Porcelaine: #f3e0d1\nIvoire: #eed6c0\nSable clair: #e8c9ab\nSable: #ddb894\nMiel: #d2a67e\nBeige doré: #c69a6e\nCaramel: #b3835a\nNoisette: #a1714b\nAmbre: #8d5f3e\nCannelle: #7a4f33\nAcajou: #61402b\nÉbène: #4a3122"
        }
      ]
    },
    {
      "type": "guarantee",
      "name": "Guarantee callout",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "30-day satisfaction guarantee"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Shop with peace of mind: if this treatment isn't right for you, we'll refund you."
        }
      ]
    },
    {
      "type": "description",
      "name": "Description (accordion)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Description & benefits"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Custom accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ingredients"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add the full INCI ingredient list here, or any content you'd like.</p>"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Product metafield (optional)",
          "info": "E.g. custom.ingredients — overrides the content above if it exists."
        }
      ]
    }
  ]
}
{% endschema %}

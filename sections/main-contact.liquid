<section class="section">
  <div class="page-width">
    <div class="page-title">
      <h1>{{ page.title | default: 'Contact us' }}</h1>
      <p>{{ section.settings.subtext }}</p>
    </div>

    <div class="contact__grid">
      <div>
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success">{{ 'contact.success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error">
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="grid grid--2" style="gap: 0 16px;">
            <div class="field">
              <label for="ContactName">{{ 'contact.name' | t }}</label>
              <input type="text" id="ContactName" name="contact[name]" class="field__input" value="{% if customer %}{{ customer.name }}{% endif %}" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="ContactEmail">{{ 'contact.email' | t }}</label>
              <input type="email" id="ContactEmail" name="contact[email]" class="field__input" value="{% if customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
            </div>
          </div>
          <div class="field">
            <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
            <input type="tel" id="ContactPhone" name="contact[phone]" class="field__input" autocomplete="tel">
          </div>
          <div class="field">
            <label for="ContactMessage">{{ 'contact.message' | t }}</label>
            <textarea id="ContactMessage" name="contact[body]" rows="6" required></textarea>
          </div>
          <button type="submit" class="btn">{{ 'contact.send' | t }}</button>
        {%- endform -%}
      </div>

      <aside class="contact__aside">
        {%- for block in section.blocks -%}
          <div class="contact__card reveal" {{ block.shopify_attributes }}>
            {% render 'icon', name: block.settings.icon, size: 26 %}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtitle",
      "default": "Question about a product, an order? We'll get back to you within 24 business hours."
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info block",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mail", "label": "Email" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Guarantee" }
          ],
          "default": "mail"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Customer care"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Response within 24 business hours, Monday through Friday."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact page",
      "blocks": [
        { "type": "info" },
        { "type": "info", "settings": { "icon": "truck", "title": "Order tracking", "text": "You'll receive a tracking email as soon as your order ships." } },
        { "type": "info", "settings": { "icon": "return", "title": "Returns & exchanges", "text": "30 days to change your mind, fast and frictionless refunds." } }
      ]
    }
  ]
}
{% endschema %}

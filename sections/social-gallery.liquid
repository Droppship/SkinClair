<section class="section section--surface">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="social-gallery__grid" style="--sg-cols: {{ section.blocks.size | at_most: 6 | at_least: 3 }};">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: settings.social_instagram | default: '#' }}"
          class="social-gallery__item reveal"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.social.follow_instagram' | t }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | escape }}"
              width="600"
              height="600"
              loading="lazy"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {% render 'icon', name: 'instagram', size: 30 %}
        </a>
      {%- endfor -%}
    </div>

    {%- if settings.social_instagram != blank and section.settings.handle != blank -%}
      <div style="text-align: center; margin-top: 28px;">
        <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" class="link-arrow">
          {% render 'icon', name: 'instagram', size: 16 %} {{ section.settings.handle }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Galerie Instagram",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Communauté"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Rejoignez-nous sur Instagram"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sous-texte",
      "default": "Partagez votre rituel avec #MonRituelSkinClair"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Identifiant Instagram",
      "default": "@skinclair"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Format carré, 600 × 600 px minimum"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (publication)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galerie Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}

<section class="section">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="grid grid--2 grid--3" style="grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          assign title = block.settings.title | default: collection.title
        -%}
        <a href="{{ collection.url | default: '#' }}" class="collection-card reveal" {{ block.shopify_attributes }}>
          {%- if image != blank -%}
            <img
              src="{{ image | image_url: width: 800 }}"
              srcset="{{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 800 }} 800w"
              sizes="(min-width: 990px) 400px, 90vw"
              alt="{{ title | escape }}"
              width="800"
              height="1000"
              loading="lazy"
            >
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div class="collection-card__content">
            <h3>{{ title | default: 'Collection' }}</h3>
            <span>{{ section.settings.cta_label }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your ritual"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Each collection answers a specific need of your skin."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link text",
      "default": "Shop now"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Its featured image and title are pulled in automatically — set them in Products → Collections."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the collection's image. 800 × 1000 px recommended — use a real product photo."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        { "type": "collection", "settings": { "title": "Face" } },
        { "type": "collection", "settings": { "title": "Body" } },
        { "type": "collection", "settings": { "title": "Wellness" } }
      ]
    }
  ]
}
{% endschema %}

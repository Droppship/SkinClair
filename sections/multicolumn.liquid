<section class="section{% if section.settings.background == 'soft' %} section--soft{% elsif section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="section-header reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p>{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="multicolumn__grid{% if section.settings.compact %} multicolumn--compact{% endif %}" style="--cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <div class="multicolumn__item reveal" {{ block.shopify_attributes }}>
          <span class="multicolumn__icon">
            {% render 'icon', name: block.settings.icon, size: 26 %}
          </span>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Columns with icons",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Ivory" },
        { "value": "soft", "label": "Soft pink" },
        { "value": "surface", "label": "White" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Compact style (trust bar)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf (natural)" },
            { "value": "drop", "label": "Drop (hydration)" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "flower", "label": "Flower" },
            { "value": "shield", "label": "Shield (guarantee)" },
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "lock", "label": "Lock (security)" },
            { "value": "return", "label": "Returns" },
            { "value": "rabbit", "label": "Rabbit (cruelty-free)" },
            { "value": "lab", "label": "Lab" },
            { "value": "recycle", "label": "Recycling" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Natural ingredients"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Clean formulas, with no compromise on efficacy."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Columns with icons",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}

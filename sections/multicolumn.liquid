<section class="section{% if section.settings.background == 'soft' %} section--soft{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="section-header reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p>{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="multicolumn__grid" style="--cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <div class="multicolumn__item reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="multicolumn__icon">
              {% render 'icon', name: block.settings.icon, size: 22 %}
            </span>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Columns with icons",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "soft", "label": "Light gray" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "sparkle", "label": "Sparkle (quality)" },
            { "value": "check", "label": "Check (easy)" },
            { "value": "leaf", "label": "Leaf (natural)" },
            { "value": "drop", "label": "Drop" },
            { "value": "heart", "label": "Heart" },
            { "value": "flower", "label": "Flower (design)" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "rabbit", "label": "Rabbit (cruelty-free)" },
            { "value": "lab", "label": "Lab" },
            { "value": "recycle", "label": "Recycling" }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quality"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Carefully designed products, made to last."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Columns with icons",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}

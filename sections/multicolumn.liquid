<section class="section{% if section.settings.background == 'soft' %} section--soft{% elsif section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="section-header reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p>{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="multicolumn__grid{% if section.settings.compact %} multicolumn--compact{% endif %}" style="--cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <div class="multicolumn__item reveal" {{ block.shopify_attributes }}>
          <span class="multicolumn__icon">
            {% render 'icon', name: block.settings.icon, size: 26 %}
          </span>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colonnes avec icônes",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sous-texte"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Ivoire" },
        { "value": "soft", "label": "Rose doux" },
        { "value": "surface", "label": "Blanc" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Style compact (bandeau de réassurance)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Colonne",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "leaf", "label": "Feuille (naturel)" },
            { "value": "drop", "label": "Goutte (hydratation)" },
            { "value": "heart", "label": "Cœur" },
            { "value": "sparkle", "label": "Éclat" },
            { "value": "flower", "label": "Fleur" },
            { "value": "shield", "label": "Bouclier (garantie)" },
            { "value": "truck", "label": "Camion (livraison)" },
            { "value": "lock", "label": "Cadenas (sécurité)" },
            { "value": "return", "label": "Retours" },
            { "value": "rabbit", "label": "Lapin (cruelty-free)" },
            { "value": "lab", "label": "Laboratoire" },
            { "value": "recycle", "label": "Recyclage" },
            { "value": "gift", "label": "Cadeau" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Ingrédients naturels"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Des formules propres, sans compromis sur l'efficacité."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colonnes avec icônes",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}

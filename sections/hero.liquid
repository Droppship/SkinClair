{%- liquid
  assign height_class = ''
  if section.settings.height == 'small'
    assign height_class = ' hero--small'
  endif
  assign style_class = ''
  if section.settings.image != blank and section.settings.text_style == 'light'
    assign style_class = ' hero--light hero--overlay'
  endif
  assign align_class = ''
  if section.settings.alignment == 'center'
    assign align_class = ' hero--center'
  endif
-%}
<section class="hero{{ height_class }}{{ style_class }}{{ align_class }}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="1800"
        height="{{ 1800 | divided_by: section.settings.image.aspect_ratio | round }}"
        fetchpriority="high"
      >
    </div>
  {%- else -%}
    <div class="hero__media">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="page-width" style="width: 100%;">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow reveal">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero__title reveal">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="hero__text reveal">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="reveal">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A clean, high-quality image. 2400 × 1400 px recommended."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beauty, made simple"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Thoughtfully designed essentials for an effortless, natural look."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to the all-products page."
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style over image",
      "options": [
        { "value": "light", "label": "Light text (dark overlay)" },
        { "value": "dark", "label": "Dark text (no overlay)" }
      ],
      "default": "light",
      "info": "Choose dark text if your image is light and text stays readable without an overlay."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "small", "label": "Small" }
      ],
      "default": "large"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

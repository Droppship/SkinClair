{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar" {% if section.blocks.size > 1 %}data-announcement-rotate{% endif %} role="region" aria-label="Annonces">
    <div class="announcement-bar__inner">
      {%- for block in section.blocks -%}
        <p class="announcement-bar__item" {% unless forloop.first %}data-hidden{% endunless %} {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonces",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "announcement",
      "name": "Annonce",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Livraison offerte dès 50 € d'achat 🌸"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (optionnel)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "announcement", "settings": { "text": "Livraison offerte dès 50 € d'achat 🌸" } },
      { "type": "announcement", "settings": { "text": "-10 % sur votre première commande avec le code BIENVENUE10" } },
      { "type": "announcement", "settings": { "text": "Satisfaite ou remboursée pendant 30 jours" } }
    ]
  }
}
{% endschema %}

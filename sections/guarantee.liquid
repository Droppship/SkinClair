<section class="section">
  <div class="page-width">
    <div class="guarantee reveal">
      {% render 'icon', name: 'shield', size: 44 %}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.small_print != blank -%}
        <small>{{ section.settings.small_print }}</small>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Garantie",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Satisfaite ou remboursée — 30 jours"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Essayez nos soins en toute sérénité. Si vous n'êtes pas conquise, nous vous remboursons intégralement, sans justification. Votre confiance est notre priorité."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Essayer sans risque"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "text",
      "id": "small_print",
      "label": "Mention légale",
      "default": "Voir les conditions dans notre politique de retour."
    }
  ],
  "presets": [
    { "name": "Garantie" }
  ]
}
{% endschema %}

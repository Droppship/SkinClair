<section class="section">
  <div class="page-width">
    <div class="guarantee reveal">
      {% render 'icon', name: 'shield', size: 44 %}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.small_print != blank -%}
        <small>{{ section.settings.small_print }}</small>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "30-day satisfaction guarantee"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Try our treatments with complete peace of mind. If you're not thrilled, we'll refund you in full, no questions asked. Your trust is our priority."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Shop risk-free"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "small_print",
      "label": "Fine print",
      "default": "See our return policy for details."
    }
  ],
  "presets": [
    { "name": "Guarantee" }
  ]
}
{% endschema %}

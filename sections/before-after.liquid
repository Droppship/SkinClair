<section class="section{% if section.settings.background == 'soft' %} section--soft{% elsif section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="ba reveal" data-before-after>
      <div class="ba__frame" style="--ba-pos: 50%;">
        <div class="ba__layer ba__layer--after">
          {%- if section.settings.image_after != blank -%}
            <img
              src="{{ section.settings.image_after | image_url: width: 1200 }}"
              srcset="{{ section.settings.image_after | image_url: width: 750 }} 750w, {{ section.settings.image_after | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 880px, 100vw"
              alt="{{ section.settings.image_after.alt | default: section.settings.label_after | escape }}"
              width="1200"
              height="{{ 1200 | divided_by: section.settings.image_after.aspect_ratio | round }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="ba__label ba__label--after">{{ section.settings.label_after }}</span>
        </div>

        <div class="ba__layer ba__layer--before">
          {%- if section.settings.image_before != blank -%}
            <img
              src="{{ section.settings.image_before | image_url: width: 1200 }}"
              srcset="{{ section.settings.image_before | image_url: width: 750 }} 750w, {{ section.settings.image_before | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 880px, 100vw"
              alt="{{ section.settings.image_before.alt | default: section.settings.label_before | escape }}"
              width="1200"
              height="{{ 1200 | divided_by: section.settings.image_before.aspect_ratio | round }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="ba__label ba__label--before">{{ section.settings.label_before }}</span>
        </div>

        <div class="ba__divider" aria-hidden="true">
          <span class="ba__handle">
            {% render 'icon', name: 'chevron-left', size: 14 %}{% render 'icon', name: 'chevron-right', size: 14 %}
          </span>
        </div>

        <input
          type="range"
          class="ba__range"
          min="0"
          max="100"
          value="50"
          step="0.1"
          data-ba-range
          aria-label="Drag to compare before and after"
        >
      </div>

      {%- if section.settings.caption != blank -%}
        <p class="ba__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before / After",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the difference"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Drag the slider to compare bare skin with skin wearing Skinclair Pressed Powder Concealer."
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before image",
      "info": "Placeholder shown until you upload your own photo. 1200 × 900 px recommended, same framing as the After image."
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After image",
      "info": "Placeholder shown until you upload your own photo. 1200 × 900 px recommended, same framing as the Before image."
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (optional)",
      "info": "Only use real, unretouched photos of the actual product result."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Ivory" },
        { "value": "soft", "label": "Soft pink" },
        { "value": "surface", "label": "White" }
      ],
      "default": "surface"
    }
  ],
  "presets": [
    { "name": "Before / After" }
  ]
}
{% endschema %}

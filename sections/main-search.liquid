<section class="section">
  <div class="page-width">
    <div class="page-title">
      <h1>{{ 'general.search.title' | t }}</h1>
      {%- if search.performed -%}
        <p>{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- endif -%}
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form" style="margin-bottom: 48px;">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        aria-label="{{ 'general.search.title' | t }}"
      >
      <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="empty-state" style="padding-top: 20px;">
          <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'general.404.browse' | t }}</a>
        </div>
      {%- else -%}
        {%- paginate search.results by 24 -%}
          <div class="collection-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', card_product: item %}
              {%- else -%}
                <article class="article-card">
                  <a href="{{ item.url }}">
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.content | strip_html | truncate: 120 }}</p>
                  </a>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" role="navigation" aria-label="Pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{% render 'icon', name: 'chevron-left', size: 16 %}</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="pagination__current">{{ part.title }}</span>
                {%- else -%}
                  <span>{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{% render 'icon', name: 'chevron-right', size: 16 %}</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page recherche",
  "settings": []
}
{% endschema %}

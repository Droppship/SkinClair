<section class="section{% if section.settings.background == 'soft' %} section--soft{% elsif section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div data-slider>
      <div class="testimonials__track" data-slider-track>
        {%- for block in section.blocks -%}
          <figure class="testimonial-card reveal" {{ block.shopify_attributes }}>
            <span class="stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}
                {% render 'icon', name: 'star', size: 16 %}
              {%- endfor -%}
            </span>
            <blockquote class="testimonial-card__quote">"{{ block.settings.quote }}"</blockquote>
            <figcaption class="testimonial-card__author">
              {{ block.settings.author }}
              {%- if block.settings.verified -%}
                <span class="testimonial-card__verified">{% render 'icon', name: 'check', size: 13 %} Verified buyer</span>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by our customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Ivory" },
        { "value": "soft", "label": "Soft pink" },
        { "value": "surface", "label": "White" }
      ],
      "default": "soft"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "My skin has never been this soft. I noticed a real difference after three weeks of use."
        },
        {
          "type": "text",
          "id": "author",
          "label": "First name",
          "default": "Emily R."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "Finally a brand that keeps its promises. Gorgeous textures, subtle scents, and super fast shipping.", "author": "Sarah M." } },
        { "type": "testimonial", "settings": { "quote": "I replaced my entire routine. The serum is now my can't-live-without morning step.", "author": "Ava B." } }
      ]
    }
  ]
}
{% endschema %}

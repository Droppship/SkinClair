<section class="section section--surface">
  <div class="page-width">
    <div
      data-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_count }}"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="section-header">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
        <div class="product-slider" data-slider>
          <div class="slider-arrows">
            <button class="slider-arrow" data-slider-prev aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 18 %}</button>
            <button class="slider-arrow" data-slider-next aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', name: 'chevron-right', size: 18 %}</button>
          </div>
          <div class="product-slider__track" data-slider-track>
            {%- for rec in recommendations.products -%}
              {% render 'product-card', card_product: rec %}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produits complémentaires",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Cross-sell"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Complétez votre routine"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Nombre de produits",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}

<section class="section{% if section.settings.background == 'soft' %} section--soft{% endif %}">
  <div class="page-width">
    <div class="rich-text reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="link-underline">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our mission"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beauty, without the noise"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>SkinClair exists to make beauty simple, quick and natural. A few carefully designed essentials — nothing more, nothing less.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "soft", "label": "Light gray" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}

<div class="collection-banner">
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <p>{{ collection.description | strip_html | truncate: 220 }}</p>
  {%- endif -%}
</div>

<div class="page-width" style="padding-bottom: 80px;">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="collection-toolbar">
      <p class="collection-toolbar__count">
        {{ collection.products_count }}
        {%- if collection.products_count == 1 %} produit{% else %} produits{% endif -%}
      </p>
      <form method="get" id="SortForm">
        <label for="SortBy" class="visually-hidden" style="position:absolute;left:-9999px;">Trier</label>
        <select name="sort_by" id="SortBy" onchange="this.form.submit()">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="collection-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" role="navigation" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 16 %}</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="pagination__current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', name: 'chevron-right', size: 16 %}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="collection-empty">
        <h2>Cette collection arrive bientôt</h2>
        <p class="text-muted" style="margin: 10px 0 26px;">Nos soins sont en préparation. Revenez très vite !</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn">Voir tous les produits</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Page collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produits par page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}

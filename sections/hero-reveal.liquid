{%- comment -%}
  Hero « révélation » lié au scroll : le boîtier part petit, flou et fermé,
  puis grossit et s'ouvre (crossfade fermé → ouvert) à mesure que l'on défile.
  L'animation est pilotée par global.js (initHeroReveal) : scroll listener
  + getBoundingClientRect, throttlé par requestAnimationFrame.
{%- endcomment -%}

<div class="hero-reveal" data-hero-reveal>
  <div class="hero-reveal__track" data-hero-track>
    <div class="hero-reveal__viewport">

      <div class="hero-reveal__copy" data-hero-copy>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="hero-reveal__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="hero-reveal__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="hero-reveal__stage" data-hero-stage>
        <div class="hero-reveal__halo" data-hero-halo></div>

        {%- if section.settings.image_open != blank -%}
          <img
            class="hero-reveal__img hero-reveal__img--open"
            data-hero-open
            src="{{ section.settings.image_open | image_url: width: 1200 }}"
            srcset="{{ section.settings.image_open | image_url: width: 750 }} 750w, {{ section.settings.image_open | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 44vh, 76vw"
            alt="{{ section.settings.image_open.alt | default: section.settings.heading | strip_html | escape }}"
            width="1200"
            height="{{ 1200 | divided_by: section.settings.image_open.aspect_ratio | round }}"
            fetchpriority="high"
          >
        {%- else -%}
          {%- comment -%} Photo produit réelle (boîtier ouvert) livrée avec le thème {%- endcomment -%}
          <img
            class="hero-reveal__img hero-reveal__img--open"
            data-hero-open
            src="{{ 'hero-compact-open.webp' | asset_url }}"
            alt="{{ section.settings.heading | strip_html | escape }}"
            width="989"
            height="1214"
            fetchpriority="high"
          >
        {%- endif -%}

        {%- if section.settings.image_closed != blank -%}
          <img
            class="hero-reveal__img hero-reveal__img--closed"
            data-hero-closed
            src="{{ section.settings.image_closed | image_url: width: 1200 }}"
            srcset="{{ section.settings.image_closed | image_url: width: 750 }} 750w, {{ section.settings.image_closed | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 44vh, 76vw"
            alt="{{ section.settings.image_closed.alt | default: section.settings.heading | strip_html | escape }}"
            width="1200"
            height="{{ 1200 | divided_by: section.settings.image_closed.aspect_ratio | round }}"
            fetchpriority="high"
          >
        {%- else -%}
          {%- comment -%} Photo produit réelle (boîtier fermé) livrée avec le thème {%- endcomment -%}
          <img
            class="hero-reveal__img hero-reveal__img--closed"
            data-hero-closed
            src="{{ 'hero-compact-closed.webp' | asset_url }}"
            alt="{{ section.settings.heading | strip_html | escape }}"
            width="822"
            height="704"
            fetchpriority="high"
          >
        {%- endif -%}

        <div class="hero-reveal__shadow" data-hero-shadow></div>
      </div>

      {%- if section.settings.hint_label != blank -%}
        <span class="hero-reveal__hint" data-hero-hint aria-hidden="true">{{ section.settings.hint_label }}</span>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero révélation (scroll)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_closed",
      "label": "Image boîtier fermé",
      "info": "Photo détourée (fond transparent) du produit fermé — état de départ. Laissez vide pour utiliser la photo officielle livrée avec le thème."
    },
    {
      "type": "image_picker",
      "id": "image_open",
      "label": "Image boîtier ouvert",
      "info": "Photo détourée du produit ouvert — révélée pendant le scroll. Laissez vide pour utiliser la photo officielle livrée avec le thème."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ÉDITION ROSE-DORÉ"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "info": "L'italique passe en rose-doré (police serif italique).",
      "default": "Un teint <em>révélé</em>, jamais masqué."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Sous-titre",
      "default": "Une formule fondante qui unifie le teint et estompe les cernes — sans jamais craqueler, du matin au soir."
    },
    {
      "type": "text",
      "id": "hint_label",
      "label": "Indication de scroll",
      "default": "Faites défiler"
    }
  ],
  "presets": [
    { "name": "Hero révélation (scroll)" }
  ]
}
{% endschema %}

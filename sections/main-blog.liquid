<section class="section">
  <div class="page-width">
    <div class="page-title">
      <span class="eyebrow">The journal</span>
      <h1>{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--3" style="gap: 40px 24px;">
        {%- for article in blog.articles -%}
          <article class="article-card reveal">
            <a href="{{ article.url }}">
              <div class="article-card__media">
                {%- if article.image -%}
                  <img
                    src="{{ article.image | image_url: width: 700 }}"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    width="700"
                    height="{{ 700 | divided_by: article.image.aspect_ratio | round }}"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <p class="article-card__date">{{ article.published_at | date: '%d %B %Y' }}</p>
              <h3>{{ article.title }}</h3>
              <p>{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
            </a>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" role="navigation" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{% render 'icon', name: 'chevron-left', size: 16 %}</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="pagination__current">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{% render 'icon', name: 'chevron-right', size: 16 %}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog page",
  "settings": []
}
{% endschema %}

<section class="section section--soft">
  <div class="page-width">
    <div class="newsletter reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="text-muted" style="margin-top: 10px;">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'SectionNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" data-newsletter-success style="margin-top: 20px;">{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="form-message form-message--error" style="margin-top: 20px;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <div class="newsletter__form">
            <input
              type="email"
              name="contact[email]"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              aria-label="{{ 'general.newsletter.label' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="btn">{{ section.settings.button_label }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "10% off your first order"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Expert tips, beauty rituals, and private offers. Once or twice a month, never spam."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Sign up"
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}

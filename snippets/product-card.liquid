{%- comment -%}
  Carte produit premium.
  Params : card_product (product), lazy (boolean, default true)
{%- endcomment -%}
{%- liquid
  assign has_second_image = false
  if card_product.media.size > 1
    assign has_second_image = true
  endif
  assign on_sale = false
  if card_product.compare_at_price_max > card_product.price_min
    assign on_sale = true
  endif
  assign is_new = false
  for tag in card_product.tags
    assign tag_downcase = tag | downcase
    if tag_downcase == 'new' or tag_downcase == 'nouveau'
      assign is_new = true
    endif
  endfor
-%}
<article class="product-card reveal">
  <a href="{{ card_product.url }}" class="product-card__media" aria-label="{{ card_product.title | escape }}">
    {%- if card_product.featured_media -%}
      <img
        src="{{ card_product.featured_media | image_url: width: 600 }}"
        srcset="{{ card_product.featured_media | image_url: width: 400 }} 400w, {{ card_product.featured_media | image_url: width: 600 }} 600w, {{ card_product.featured_media | image_url: width: 900 }} 900w"
        sizes="(min-width: 990px) 300px, 50vw"
        alt="{{ card_product.featured_media.alt | default: card_product.title | escape }}"
        width="600"
        height="{{ 600 | divided_by: card_product.featured_media.aspect_ratio | round }}"
        {% unless lazy == false %}loading="lazy"{% endunless %}
        class="product-card__img product-card__img--primary"
      >
      {%- if has_second_image -%}
        <img
          src="{{ card_product.media[1] | image_url: width: 600 }}"
          alt=""
          width="600"
          height="{{ 600 | divided_by: card_product.media[1].aspect_ratio | round }}"
          loading="lazy"
          aria-hidden="true"
          class="product-card__img product-card__img--secondary"
        >
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-2' | placeholder_svg_tag: 'product-card__img placeholder-svg' }}
    {%- endif -%}

    <div class="product-card__badges">
      {%- if on_sale -%}
        <span class="badge badge--sale">{{ 'products.on_sale' | t }}</span>
      {%- endif -%}
      {%- if is_new -%}
        <span class="badge badge--new">{{ 'products.new' | t }}</span>
      {%- endif -%}
      {%- unless card_product.available -%}
        <span class="badge badge--soldout">{{ 'products.sold_out' | t }}</span>
      {%- endunless -%}
    </div>
  </a>

  <div class="product-card__info">
    <h3 class="product-card__title">
      <a href="{{ card_product.url }}">{{ card_product.title }}</a>
    </h3>
    {%- if card_product.metafields.custom.subtitle != blank -%}
      <p class="product-card__subtitle">{{ card_product.metafields.custom.subtitle }}</p>
    {%- elsif card_product.type != blank -%}
      <p class="product-card__subtitle">{{ card_product.type }}</p>
    {%- endif -%}
    {% render 'price', item: card_product, class: 'price--card' %}
  </div>

  {%- if settings.show_quick_add and card_product.available -%}
    {%- if card_product.variants.size == 1 -%}
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="product-card__quick-add" data-ajax-add>
        <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
        <button type="submit" class="btn btn--card" aria-label="{{ 'products.add_to_cart' | t }} — {{ card_product.title | escape }}">
          {{ 'products.add_to_cart' | t }}
        </button>
      </form>
    {%- else -%}
      <div class="product-card__quick-add">
        <a href="{{ card_product.url }}" class="btn btn--card">{{ 'products.choose_options' | t }}</a>
      </div>
    {%- endif -%}
  {%- endif -%}
</article>

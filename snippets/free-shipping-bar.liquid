{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  else
    assign progress = 100
  endif
-%}
{%- if threshold > 0 -%}
  <div class="free-shipping-bar" aria-live="polite">
    <p class="free-shipping-bar__label">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <div class="free-shipping-bar__track">
      <div class="free-shipping-bar__fill" style="width: {{ progress }}%;"></div>
    </div>
  </div>
{%- endif -%}

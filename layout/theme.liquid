<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Inter:wght@400;500&display=swap" rel="stylesheet">

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --c-bg: {{ settings.color_background }};
        --c-text: {{ settings.color_text }};
        --c-muted: {{ settings.color_muted }};
        --c-accent: {{ settings.color_accent }};
        --c-soft: {{ settings.color_soft }};
        --c-line: {{ settings.color_line }};
        --page-width: {{ settings.page_width }}px;
      }
    </style>

    <script>
      window.routes = {
        root_url: {{ routes.root_url | json }},
        cart_url: {{ routes.cart_url | json }},
        cart_add_url: {{ routes.cart_add_url | json }},
        cart_change_url: {{ routes.cart_change_url | json }},
        search_url: {{ routes.search_url | json }},
        predictive_search_url: {{ routes.predictive_search_url | json }}
      };
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          added: {{ 'products.added' | t | json }}
        }
      };
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% section 'cart-drawer' %}

    <div class="page-overlay" data-overlay hidden></div>
  </body>
</html>
